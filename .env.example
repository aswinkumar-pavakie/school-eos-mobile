# Copy to .env.local (or export in your shell) for local development.
# Never commit a real .env file - only this .env.example.
#
# Everything here is PUBLIC runtime/build configuration, never a secret.
# EXPO_PUBLIC_* variables are bundled into the client and are readable by
# anyone with the app installed - see docs/security/overview.md. This app
# holds no API keys, signing secrets, or service-role credentials; those
# live only on the backend.

# Build-time: selects which app.config.ts branch to use (development | preview | production).
APP_ENV=development

# Public runtime: the API's base URL for this environment (the client appends /api/v1 itself).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Build-time only, used by EAS builds - not read by the app at runtime.
# EAS_PROJECT_ID=PLACEHOLDER-EAS-PROJECT-ID
